datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String          @id @default(uuid())
  username            String          @unique
  email               String          @unique
  passwordHash        String
  avatar              String          @default("code-ninja")
  currentStreak       Int             @default(0)
  longestStreak       Int             @default(0)
  lastDuelDate        String?         // YYYY-MM-DD format for calendar day comparison
  totalDuels          Int             @default(0)
  totalWins           Int             @default(0)
  totalLosses         Int             @default(0)
  totalCorrectAnswers Int             @default(0)
  // Rating & Progression v1.0
  oneWordRating       Int             @default(1000)
  mcqRating           Int             @default(1000)
  typingRating        Int             @default(1000)
  totalXP             Int             @default(0)
  currentLevel        Int             @default(1)
  totalCompletedMatches Int           @default(0)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  matches             Match[]
  ratingHistories     RatingHistory[]

  @@index([totalCorrectAnswers(sort: Desc)])
  @@index([totalWins(sort: Desc)])
  @@index([oneWordRating(sort: Desc)])
  @@index([mcqRating(sort: Desc)])
  @@index([typingRating(sort: Desc)])
  @@index([totalXP(sort: Desc)])
}

model Question {
  id              String   @id @default(uuid())
  language        String   // "cpp", "java", "python"
  duelType        String   @default("ONE_WORD") // "ONE_WORD", "MCQ", "TYPING"
  question        String
  correctAnswer   String
  acceptedAliases Json     @default("[]") // string array of aliases (for One-Word)
  options         Json     @default("[]") // string array of 4 options (for MCQ)
  difficulty      String   @default("beginner")
  createdAt       DateTime @default(now())

  @@index([language, duelType])
}

model Match {
  id                  String          @id @default(uuid())
  userId              String
  botName             String
  language            String          // "cpp", "java", "python"
  duelType            String          @default("ONE_WORD") // "ONE_WORD", "MCQ", "TYPING"
  difficulty          String          @default("medium") // "easy", "medium", "hard"
  userScore           Int
  botScore            Int
  correctAnswers      Int
  incorrectAnswers    Int
  grade               String          // "F", "D", "C", "B", "A", "S"
  result              String          // "WIN", "LOSS", "DRAW"
  duration            Int             @default(60)
  startedAt           DateTime        @default(now())
  completedAt         DateTime        @default(now())
  // Typing Duel specific fields (nullable)
  userWpm             Int?
  userAccuracy        Float?
  userCorrectChars    Int?
  userTotalChars      Int?
  botWpm              Int?
  botCorrectChars     Int?
  referencePassageId  String?
  // Rating & Progression v1.0
  botRating           Int             @default(1200)
  ratingChange        Int?
  previousRating      Int?
  newRating           Int?
  xpEarned            Int?

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingHistories     RatingHistory[]

  @@index([userId, duelType])
  @@index([language])
  @@index([completedAt(sort: Desc)])
  @@index([userId, userWpm(sort: Desc)])
  @@index([completedAt(sort: Desc), duelType])
}

model RatingHistory {
  id            String   @id @default(uuid())
  userId        String
  matchId       String
  duelType      String   // "ONE_WORD", "MCQ", "TYPING"
  previousRating Int
  newRating     Int
  ratingChange  Int
  botRating     Int
  botDifficulty String   // "easy", "medium", "hard"
  result        String   // "WIN", "LOSS", "DRAW"
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId, duelType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([duelType, createdAt(sort: Desc)])
}
